# systemd 单元。放到 /etc/systemd/system/atara-pay.service
#
#   systemctl daemon-reload
#   systemctl enable --now atara-pay
#   journalctl -u atara-pay -f

[Unit]
Description=Atara settlement backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atara
Group=atara
WorkingDirectory=/srv/atara

# 这一版跑 mock 链：不连 RPC、不签真交易、不需要任何私钥。
# 整个 .env 因此不存在——签名私钥这一类风险直接从这台机器上消失了。
# 换真链时才需要把 EnvironmentFile=/srv/atara/.env 加回来（0600，属主 atara）。
Environment=ATARA_CHAIN_IMPL=mock
Environment=ATARA_AGENT_IMPL=mock

# 只监听回环：公网入口只有 nginx 一个
Environment=ATARA_HTTP_ADDR=127.0.0.1:8080
Environment=ATARA_DB_PATH=/srv/atara/data/atara.db
Environment=ATARA_UPLOAD_DIR=/srv/atara/data/uploads
# 同源部署不需要 CORS。留空比留 * 安全：万一哪天后端被直接暴露，
# 至少浏览器这一侧不会替攻击者放行。
Environment=ATARA_CORS_ORIGINS=
# 秒级节奏。这台机器是放给人看流程的：真实时长下付款窗口 4 小时、
# 平台核验 2 小时，一笔单子当着人的面根本走不完，屏幕上只会停在
# 「等待中」。要按真实时长跑，把这里改成 false。
Environment=ATARA_DEMO_TIMING=true

ExecStart=/srv/atara/bin/atara-pay
Restart=always
RestartSec=3

# 收紧权限：只有数据目录可写
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/atara/data

[Install]
WantedBy=multi-user.target
