# BSC 测试网（chainId 97）。这个文件在 .gitignore 里，不会进仓库。
ATARA_CHAIN_IMPL=evm
ATARA_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ATARA_NETWORK=BSC-TESTNET
ATARA_EXPLORER=https://testnet.bscscan.com

# 已有的 USDT（你部的，18 位精度，symbol=USDT）
ATARA_TOKEN_USDT=0x5776861b6839320A87fD87FAD05D8061a01f8E80
# USDC 是部署时新部的测试币，给部署者铸了 100 万
ATARA_TOKEN_USDC=0xA8D4114EDe4639a3C23611913f2aab8Eb7C04Ae7

# 部署后把 make chain-deploy 打印的这两行填回来
ATARA_ESCROW_ADDR=0xd90740B79f7546a9Cfc0925ca4D521Bf20CDcD3C
ATARA_SPENDING_ADDR=0xCcD52bcc08767256A756cC42d72DeFEEE1ef05F9

# Demo 里唯一的私钥：既签交易，也签放行证明。
#
# 这把私钥丢了，托管合约里的钱就能被放走——单签名方、阈值 1。
# 它已经出现在一次对话记录里，只当测试网用，永远不要拿它碰主网。
# 上真钱之前必须换成多签名方、阈值 >= 2，各签名方在独立主机上持有独立密钥。
#
# 地址 0x697940eee5d37d0f7a380eb17f8efd2df65c9276
ATARA_SIGNER_KEY=0x2a2386448e94e13a30dda08b8f7e06242c4fce24706b8850b9d6a32e9aaece92

IDANALYZER_API_KEY=idk_WI3k2lWRwbX10JdFcYnpSSC5yE1lrDwufPQB4otU
# 门户里建的 KYC 配置档 ID。也可以直接用内置预设：
#   security_high / security_medium / security_low / security_none
# 用预设不必先去门户建档就能跑通，代价是**没有 webhook**——webhook URL 配在
# 配置档上。没有回调也不会卡住：后端在前端每次查状态时会主动去拉一次。
IDANALYZER_PROFILE=security_medium

# us（洛杉矶）| eu（法兰克福）。个人信息只存放在提交去的那一侧，不跨区同步。
IDANALYZER_REGION=us

# 让用户做什么：0 证件+人脸，1 只证件，2 只人脸，3 只签署。
# 默认 0——OTC 的法币腿要认人，只读证件不做人脸等于没认。
#IDANALYZER_MODE=0

# 门户里 API Keys → Webhook Signing Secret。
#
# 回调用 HMAC-SHA256 签名，没配这个就**拒收所有回调**：「没配置」和「验过了」
# 是两件事，混成一件等于这个接口谁都能打，而它改的是放不放行一个账户去收
# 别人的法币。
#
# 回调地址填 https://你的域名/webhooks/idanalyzer（要公网可达的 HTTPS）。
IDANALYZER_WEBHOOK_SECRET=pw9YNSTtyMU0qMVo0FBCQXYh9KN1a96BnhtQlEgK9HeVsrJj