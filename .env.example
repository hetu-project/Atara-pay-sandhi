# 链实现：mock（默认，内存 + SQLite）| evm（真链）
ATARA_CHAIN_IMPL=evm

# 本地 anvil 用 http://127.0.0.1:8545；BSC 测试网用下面这个
ATARA_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ATARA_NETWORK=BSC-TESTNET
ATARA_EXPLORER=https://testnet.bscscan.com

# 部署后填这几个（make chain-deploy 的输出里有）
ATARA_ESCROW_ADDR=
# 支配权策略合约。不配则额度只有平台侧记录，链上没有真实授权。
ATARA_SPENDING_ADDR=
# 链上已经有能用的币就填地址，部署脚本会直接用它；
# 留空则部署时新部一个测试币，把打印出来的地址填回来。
ATARA_TOKEN_USDT=
ATARA_TOKEN_USDC=

# Demo 里唯一的私钥：既签交易，也签放行证明。
#
# 这把私钥丢了，托管合约里的钱就能被放走——它是单签名方、阈值 1 的配置。
# 绝不提交进仓库（.env 已在 .gitignore 里）。上真钱之前必须换成多签名方、
# 阈值 >= 2，且各签名方在独立主机上持有独立密钥。
#
# 下面这个是 anvil 的公开开发私钥，只在本地测试链上有意义。
ATARA_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 调度器多久扫一次到期工单 —— 接了真链就是「多久去链上确认一次状态」。
# 不配的话：真链每分钟，mock 每秒。
#ATARA_SCHED_TICK=1m

# 灌那套演示数据（10 家做市方、10 条挂单、联系人、余额、额度）。
# 默认 false：空库，所有东西从界面上真做出来。
#ATARA_SEED=true

# ── 科大讯飞实时语音听写（IAT）──
#
# 输入框那颗麦克风。后端只用它签一枚带时效的 WSS URL，音频不过后端——
# 浏览器直连讯飞。APIKey / APISecret 绝不下发到浏览器：进了 JS 产物
# 就是公开文件，任何人都能拿去刷我们的额度。
#
# 三个缺一个，/api/v1/voice/iflytek-token 返回 VOICE_NOT_CONFIGURED，
# 只有这一个功能不可用，不影响别的。
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# ── 身份核验：ID Analyzer / DocuPass ──
#
# 证件拍照、正反面、人脸活体全在 ID Analyzer 的托管页面里完成，影像不经过
# 我们。浏览器这一侧只拿到一枚短效、单次有效的 reference。
#
# APIKey 绝不下发到浏览器——ID Analyzer 自己的文档把这条写成硬规矩：
# 应用绝不可直接调 POST /docupass 或 GET /docupass/{reference}。拿到这把 key
# 就能替我们建会话、读任何一次核验的完整人像和证件号。
#
# 不配的话 /api/v1/kyc/session 返回 KYC_NOT_CONFIGURED，界面上照实说
# 「这台机器没开身份核验」，只有这一件事不可用。
IDANALYZER_API_KEY=

# 门户里建的 KYC 配置档 ID。也可以直接用内置预设：
#   security_high / security_medium / security_low / security_none
# 用预设不必先去门户建档就能跑通，代价是**没有 webhook**——webhook URL 配在
# 配置档上。没有回调也不会卡住：后端在前端每次查状态时会主动去拉一次。
IDANALYZER_PROFILE=security_medium

# us（洛杉矶）| eu（法兰克福）。个人信息只存放在提交去的那一侧，不跨区同步。
IDANALYZER_REGION=us

# 让用户做什么：0 证件+人脸，1 只证件，2 只人脸，3 只签署。
# 默认 0——OTC 的法币腿要认人，只读证件不做人脸等于没认。
#IDANALYZER_MODE=0

# 托管页面的界面语言。默认 en。
#
# 不定的话 DocuPass 按浏览器语言挑，一台中文系统打开的是中文界面，而这个
# 控制台整体是英文的——同一个弹窗里外两种语言。语言该跟着产品走，不跟着
# 操作系统走。
#
# 取值是 DocuPass 自己那套键，不是 BCP-47：en / cn（简中）/ tw（繁中）/
# ja / ko / fr / de / es / pt / ar / hi / th / vi / id / tl / nl / he /
# bn / ur / ro / pl。写成 zh-CN 认不出来，会悄悄退回按浏览器猜。
#IDANALYZER_LANGUAGE=en

# 门户里 API Keys → Webhook Signing Secret。
#
# 回调用 HMAC-SHA256 签名，没配这个就**拒收所有回调**：「没配置」和「验过了」
# 是两件事，混成一件等于这个接口谁都能打，而它改的是放不放行一个账户去收
# 别人的法币。
#
# 回调地址填 https://你的域名/webhooks/idanalyzer（要公网可达的 HTTPS）。
IDANALYZER_WEBHOOK_SECRET=
