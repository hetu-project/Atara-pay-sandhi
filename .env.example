# 链实现：mock（默认，内存 + SQLite）| evm（真链）
ATARA_CHAIN_IMPL=evm

# 本地 anvil 用 http://127.0.0.1:8545；BSC 测试网用下面这个
ATARA_RPC_URL=https://bsc-testnet-rpc.publicnode.com
ATARA_NETWORK=BSC-TESTNET
ATARA_EXPLORER=https://testnet.bscscan.com

# 部署后填这几个（make chain-deploy 的输出里有）
ATARA_ESCROW_ADDR=
# 支配权策略合约。不配则额度只有平台侧记录，链上没有真实授权。
ATARA_SPENDING_ADDR=
# 链上已经有能用的币就填地址，部署脚本会直接用它；
# 留空则部署时新部一个测试币，把打印出来的地址填回来。
ATARA_TOKEN_USDT=
ATARA_TOKEN_USDC=

# Demo 里唯一的私钥：既签交易，也签放行证明。
#
# 这把私钥丢了，托管合约里的钱就能被放走——它是单签名方、阈值 1 的配置。
# 绝不提交进仓库（.env 已在 .gitignore 里）。上真钱之前必须换成多签名方、
# 阈值 >= 2，且各签名方在独立主机上持有独立密钥。
#
# 下面这个是 anvil 的公开开发私钥，只在本地测试链上有意义。
ATARA_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 调度器多久扫一次到期工单 —— 接了真链就是「多久去链上确认一次状态」。
# 不配的话：真链每分钟，mock 每秒。
#ATARA_SCHED_TICK=1m

# 灌那套演示数据（10 家做市方、10 条挂单、联系人、余额、额度）。
# 默认 false：空库，所有东西从界面上真做出来。
#ATARA_SEED=true

# ── 科大讯飞实时语音听写（IAT）──
#
# 输入框那颗麦克风。后端只用它签一枚带时效的 WSS URL，音频不过后端——
# 浏览器直连讯飞。APIKey / APISecret 绝不下发到浏览器：进了 JS 产物
# 就是公开文件，任何人都能拿去刷我们的额度。
#
# 三个缺一个，/api/v1/voice/iflytek-token 返回 VOICE_NOT_CONFIGURED，
# 只有这一个功能不可用，不影响别的。
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# ── Atara AI 对话台（DeepSeek）──
#
# 没配 API key 时对话台照常收消息，只是回一句「暂时只能留言」的固定话术，
# 别的功能不受影响。
#
# 当前阶段**不限次数**（按产品要求）。注意这套部署没有访问控制、鉴权又是
# mock（X-Atara-User 写谁就是谁），所以线上放开之前得先有 TLS 和访问控制，
# 否则任何人都能拿它烧额度、还能冒充任意身份去问。
DEEPSEEK_API_KEY=
#DEEPSEEK_MODEL=deepseek-chat
#DEEPSEEK_BASE_URL=https://api.deepseek.com
# 单次回答的长度上限（不是次数上限）。
#DEEPSEEK_MAX_TOKENS=800
