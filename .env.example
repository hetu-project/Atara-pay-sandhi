# 链实现：mock（默认，内存 + SQLite）| evm（真链）
ATARA_CHAIN_IMPL=evm

ATARA_RPC_URL=http://127.0.0.1:8545
ATARA_NETWORK=BSC-TESTNET
ATARA_EXPLORER=https://testnet.bscscan.com

# 部署后填这三个（forge script 的输出里有）
ATARA_ESCROW_ADDR=
# 支配权策略合约。不配则额度只有平台侧记录，链上没有真实授权。
ATARA_SPENDING_ADDR=
ATARA_TOKEN_USDT=
ATARA_TOKEN_USDC=

# Demo 里唯一的私钥：既签交易，也签放行证明。
#
# 这把私钥丢了，托管合约里的钱就能被放走——它是单签名方、阈值 1 的配置。
# 绝不提交进仓库（.env 已在 .gitignore 里）。上真钱之前必须换成多签名方、
# 阈值 >= 2，且各签名方在独立主机上持有独立密钥。
#
# 下面这个是 anvil 的公开开发私钥，只在本地测试链上有意义。
ATARA_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
